---
const portfolioUrl = 'https://app.notion.com/p/Fahad-Imran-Selected-Work-3d996b19fa02816a9d53ec8361327937?source=copy_link';

const products = [
  {
    name: 'Nomod',
    logo: '/brands/nomod.webp',
    href: 'https://nomod.com',
    description: 'Accept payments over WhatsApp',
  },
  {
    name: 'Pine',
    logo: '/brands/pine.webp',
    href: 'https://apps.apple.com/no/app/pine-the-app/id6467567252',
    description: 'Group buying for restaurants and cafes',
  },
  {
    name: 'Rayne',
    logo: '/brands/rayne.webp',
    href: 'https://wearerayne.com',
    description: 'On-demand lawyers for businesses',
  },
  {
    name: 'Maple',
    logo: '/brands/maple.webp',
    href: 'https://www.linkedin.com/company/maplehr',
    description: 'HR management for growing teams',
  },
  {
    name: 'Leaf',
    logo: '/brands/leaf.webp',
    href: 'https://sharewithleaf.com',
    description: 'Audio stories, saved for family',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta
      name="description"
      content="Fahad Imran is a software and product engineer who builds thoughtful products across web and mobile."
    />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link
      rel="preload"
      href="/fonts/inter-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>Fahad Imran — Software & product engineer</title>
  </head>
  <body>
    <main>
      <div class="intro-row">
        <h1>hi, i’m fahad.</h1>
      </div>

      <section class="statement" aria-label="Introduction">
        <p>i’m a software engineer from pakistan 🇵🇰. mostly, i make useful things and obsess over the details nobody should have to notice.</p>

        <div class="product-line">
          <p>some things i’ve helped ship</p>
          <div class="product-list" aria-label="Products I have helped ship">
            {products.map((product) => (
              <a
                class="product"
                href={product.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${product.name}: ${product.description}`}
              >
                <img src={product.logo} alt="" width="32" height="32" />
                <span class="product-tooltip" role="tooltip" aria-hidden="true">{product.name} — {product.description}</span>
              </a>
            ))}
          </div>
        </div>

        <p>for the longer version, here’s my <a class="text-link" href={portfolioUrl} target="_blank" rel="noopener noreferrer">selected work</a>.</p>
      </section>

      <footer>
        <figure class="closing-portrait">
          <img
            src="/profile.webp"
            alt="Fahad Imran"
            width="200"
            height="200"
            loading="lazy"
          />
        </figure>
        <p>you can find me on</p>
        <nav aria-label="Social links">
          <a href="https://github.com/fahadimran7" target="_blank" rel="noopener noreferrer">github</a>
          <a href="https://linkedin.com/in/fahadimran7" target="_blank" rel="noopener noreferrer">linkedin</a>
          <a href="mailto:fahadimran6544@gmail.com">email</a>
          <a href="/resume.pdf" download>resume</a>
        </nav>
        <p class="sign-off">p.s. always happy to talk through a stubborn idea.</p>
      </footer>
    </main>

  </body>
</html>

<style>
  @font-face {
    font-family: 'Inter Local';
    src: url('/fonts/inter-variable.woff2') format('woff2-variations');
    font-style: normal;
    font-weight: 100 900;
    font-display: block;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #fff;
    color: #1f2937;
    font-family: 'Inter Local', Inter, system-ui, sans-serif;
    font-synthesis: none;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    background: #fff;
  }

  :global(a) {
    color: inherit;
  }

  main {
    width: min(100% - 64px, 575px);
    margin: 0 auto;
    padding: 120px 0 64px;
  }

  .product-line {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  h1,
  p {
    margin: 0;
    font: inherit;
  }

  h1,
  .statement {
    font-size: 24px;
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: -0.025em;
  }

  h1 {
    font-size: 38px;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.045em;
  }

  .statement {
    display: grid;
    gap: 28px;
    margin-top: 56px;
  }

  .statement > p:first-child {
    max-width: 680px;
  }

  .product-line {
    flex-wrap: wrap;
    gap: 14px;
  }

  .product-list {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .product {
    position: relative;
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    overflow: visible;
    border-radius: 13px;
    outline: none;
  }

  .product img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product:focus-visible {
    opacity: 0.68;
  }

  .product-tooltip {
    position: absolute;
    bottom: calc(100% + 9px);
    left: 50%;
    z-index: 10;
    width: max-content;
    max-width: calc(100vw - 24px);
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(22, 24, 29, 0.93);
    color: #fff;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.012em;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 4px);
    transition: opacity 120ms ease, transform 120ms ease;
  }

  .product:hover .product-tooltip,
  .product:focus-visible .product-tooltip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .text-link,
  footer a {
    color: #0077ff;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .text-link {
    text-decoration: none;
  }

  .text-link:hover,
  footer a:hover {
    color: #6d3fcc;
    text-decoration-color: currentColor;
  }

  .text-link:focus-visible,
  footer a:focus-visible {
    border-radius: 2px;
    outline: 2px solid #2563eb;
    outline-offset: 4px;
  }

  .closing-portrait {
    flex: 0 0 100%;
    margin: 0 0 16px;
  }

  .closing-portrait img {
    display: block;
    width: 200px;
    height: 200px;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 39%;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 7px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px dotted #cfd4dc;
    color: #626b78;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: -0.012em;
  }

  footer nav {
    display: flex;
    gap: 7px;
  }

  footer nav a:not(:last-child)::after {
    content: ',';
    color: #626b78;
    text-decoration: none;
  }

  .sign-off {
    flex-basis: 100%;
    color: #8a919c;
  }

  @media (max-width: 620px) {
    main {
      width: min(100% - 48px, 575px);
      padding-top: 56px;
    }

    .statement {
      gap: 28px;
      margin-top: 48px;
    }

    h1 {
      font-size: 34px;
    }

    .product-line {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .product-list {
      flex-wrap: wrap;
    }

    .product,
    .product img {
      width: 32px;
      height: 32px;
    }

    footer {
      margin-top: 60px;
    }

    .closing-portrait {
      margin-bottom: 14px;
    }

    .closing-portrait img {
      width: 160px;
      height: 160px;
    }
  }

  @media (hover: none), (pointer: coarse) {
    .product-tooltip {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text-link,
    footer a,
    .product-tooltip {
      transition: none;
    }
  }
</style>
