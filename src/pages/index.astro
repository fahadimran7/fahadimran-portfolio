---
import Base from '../layouts/Base.astro';
import { Github, Linkedin, Mail } from 'lucide-astro';

interface ContributionDay {
  date: string;
  count: number;
  level: number;
}

let contributionGrid: (ContributionDay | null)[][] = [];
let totalContributions = 0;
let monthLabels: { col: number; label: string }[] = [];

try {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 8000);
  const res = await fetch('https://github-contributions-api.jogruber.de/v4/fahadimran7?y=last', {
    signal: controller.signal,
  });
  clearTimeout(timeoutId);

  if (res.ok) {
    const data = await res.json() as {
      total: Record<string, number>;
      contributions: ContributionDay[];
    };
    const contributions = data.contributions || [];

    totalContributions = Object.values(data.total || {}).reduce((sum, val) => {
      return typeof val === 'number' ? sum + val : sum;
    }, 0);

    const weeks: (ContributionDay | null)[][] = [];
    let currentWeek: (ContributionDay | null)[] = new Array(7).fill(null);

    for (const day of contributions) {
      const date = new Date(day.date);
      const dow = date.getDay();

      if (dow === 0 && currentWeek.some(d => d !== null)) {
        weeks.push([...currentWeek]);
        currentWeek = new Array(7).fill(null);
      }

      currentWeek[dow] = day;
    }

    if (currentWeek.some(d => d !== null)) {
      weeks.push([...currentWeek]);
    }

    contributionGrid = weeks;

    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    let lastMonth = -1;
    for (let i = 0; i < weeks.length; i++) {
      const firstDay = weeks[i].find(d => d !== null);
      if (!firstDay) continue;
      const month = new Date(firstDay.date).getMonth();
      if (month !== lastMonth) {
        monthLabels.push({ col: i, label: months[month] });
        lastMonth = month;
      }
    }
  }
} catch {
  // Silently fail — graph won't render
}

const filteredMonthLabels = monthLabels.filter((m, i, arr) => {
  if (i === 0) return true;
  return m.col - arr[i - 1].col >= 3;
});
---
