---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import ContactCta from '../components/ContactCta.astro';
import { featuredProjects } from '../data/projects';
import { testimonials } from '../data/testimonials';
import { ArrowDown } from 'lucide-astro';
---

<Base
  title="Home"
  description="Product engineer building payment products in small startup teams, from ambiguous problems to shipped features across web and mobile."
>
  <section class="hero">
    <div class="hero-text">
      <h1>Product engineer building payment products for 40,000+ GCC merchants.</h1>
    </div>

    <p class="bio">
      I work inside small startup teams, turning ambiguous problems into shipped features across web and mobile.
    </p>

    <div class="hero-actions">
      <a class="btn-solid" href="#selected-work">View selected work <ArrowDown size={15} /></a>
      <a class="btn-ghost" href="mailto:fahadimran6544@gmail.com">Get in touch</a>
    </div>
  </section>

  <section class="selected-work" id="selected-work" aria-labelledby="selected-work-heading">
    <div class="section-heading-row">
      <p class="section-label" id="selected-work-heading">Selected work</p>
      <a href="/work" class="section-link">View all work →</a>
    </div>
    <div class="featured-project-grid">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} variant="featured" />
      ))}
    </div>
  </section>

  <section class="testimonials" aria-labelledby="testimonials-heading">
    <div class="testimonials-intro">
      <p class="section-label">Kind words</p>
      <h2 id="testimonials-heading">People I’ve worked with say it better.</h2>
      <p>Unprompted, unedited, and suspiciously kind.</p>
    </div>

    <div class:list={['testimonial-grid', { 'testimonial-grid--single': testimonials.length === 1 }]}>
      {testimonials.map((testimonial) => (
        <TestimonialCard testimonial={testimonial} />
      ))}
    </div>
  </section>

  <ContactCta />
</Base>

<style>
  .hero {
    max-width: 980px;
    margin-bottom: 88px;
  }

  .hero-text h1 {
    font-size: clamp(42px, 5.1vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.045em;
    margin-bottom: 24px;
    text-wrap: balance;
  }

  .bio {
    max-width: 710px;
    font-size: 20px;
    margin-bottom: 28px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .selected-work {
    scroll-margin-top: 96px;
    margin-bottom: 80px;
  }

  .section-heading-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 20px;
  }

  .section-heading-row .section-label {
    margin-bottom: 0;
  }

  .section-link {
    color: var(--muted);
    font-size: 13px;
    text-decoration: none;
  }

  .section-link:hover {
    color: var(--text);
  }

  .featured-project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .testimonials {
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.45fr);
    align-items: start;
    gap: clamp(36px, 7vw, 104px);
    margin-bottom: 88px;
    padding-top: 8px;
  }

  .testimonials-intro {
    position: sticky;
    top: 112px;
  }

  .testimonials-intro .section-label {
    margin-bottom: 14px;
  }

  .testimonials-intro h2 {
    max-width: 520px;
    color: var(--muted);
    font-size: clamp(34px, 3.7vw, 52px);
    font-weight: 500;
    line-height: 1.13;
    letter-spacing: -0.038em;
    text-wrap: balance;
  }

  .testimonials-intro > p:last-child {
    margin-top: 18px;
    color: var(--muted);
    font-size: 14px;
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .testimonial-grid--single {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 900px) {
    .featured-project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .testimonials {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .testimonials-intro {
      position: static;
    }

    .testimonials-intro h2 {
      max-width: 680px;
    }
  }

  @media (max-width: 570px) {
    .hero {
      margin-bottom: 68px;
    }

    .hero-text h1 {
      font-size: clamp(38px, 11vw, 48px);
    }

    .bio {
      font-size: 18px;
    }

    .featured-project-grid {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .selected-work,
    .testimonials {
      margin-bottom: 64px;
    }

  }
</style>
