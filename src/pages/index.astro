---
import Base from '../layouts/Base.astro';
import { Twitter, Github, Linkedin, Mail } from 'lucide-astro';
---
<Base title="Home" description="Product and engineering. Mostly at startups, mostly moving fast. Nights go to building things I kept wishing someone else would make.">

  <div class="hero">
    <img class="avatar" src="/images/profile-photo.webp" alt="Fahad Imran" />
    <div class="hero-text">
      <h1>Fahad Imran</h1>
      <p>product and code, mostly in that order</p>
    </div>
  </div>

  <p class="bio">
    Product and engineering at startups by day. Building things on the side at night. Some of them stuck.
  </p>

  <div class="section-row">
    <p class="section-label">Places I've worked at</p>
    <div class="chip-list">

      <div class="chip-wrap">
        <span class="chip-tooltip">where i started, part-time</span>
        <a class="chip" href="https://www.linkedin.com/company/tuamify" target="_blank" rel="noopener">
          <span class="chip-icon"><img src="/images/tuamify-logo.webp" alt="" /></span>
          Tuamify
        </a>
      </div>

      <div class="chip-wrap">
        <span class="chip-tooltip">where I used to work</span>
        <a class="chip" href="https://devsinc.com" target="_blank" rel="noopener">
          <span class="chip-icon"><img src="/images/devsinc-logo.svg" alt="" style="width:20px;height:20px;" /></span>
          Devsinc
        </a>
      </div>

      <div class="chip-wrap">
        <span class="chip-tooltip">where I work now :)</span>
        <a class="chip" href="https://alfabolt.com" target="_blank" rel="noopener">
          <span class="chip-icon" style="border-radius:50%;"><img src="/images/alfabolt-logo-1.webp" alt="" style="width:46px;height:46px;" /></span>
          Alfabolt
        </a>
      </div>

    </div>
  </div>

  <div class="section-row" style="margin-bottom:56px;">
    <p class="section-label">Products I've shipped</p>
    <div class="chip-list">

      <div class="chip-wrap">
        <span class="chip-tooltip">Accept payments over WhatsApp</span>
        <a class="chip" href="https://nomod.com" target="_blank" rel="noopener">
          <span class="chip-icon"><img src="/images/nomod-logo.webp" alt="" /></span>
          Nomod
        </a>
      </div>

      <div class="chip-wrap">
        <span class="chip-tooltip">Group buying for restaurants and cafes</span>
        <a class="chip" href="https://apps.apple.com/no/app/pine-the-app/id6467567252" target="_blank" rel="noopener">
          <span class="chip-icon"><img src="/images/pine-logo.webp" alt="" /></span>
          Pine
        </a>
      </div>

      <div class="chip-wrap">
        <span class="chip-tooltip">Audio stories, saved for family</span>
        <a class="chip" href="https://sharewithleaf.com" target="_blank" rel="noopener">
          <span class="chip-icon"><img src="/images/leaf-logo.webp" alt="" /></span>
          Leaf
        </a>
      </div>

      <div class="chip-wrap">
        <span class="chip-tooltip">On-demand lawyers for businesses</span>
        <a class="chip" href="https://wearerayne.com" target="_blank" rel="noopener">
          <span class="chip-icon"><img src="/images/rayne-logo.webp" alt="" /></span>
          Rayne
        </a>
      </div>

      <div class="chip-wrap">
        <span class="chip-tooltip">HR management for teams</span>
        <a class="chip" href="https://www.linkedin.com/company/maplehr" target="_blank" rel="noopener">
          <span class="chip-icon"><img src="/images/maple-logo.webp" alt="" /></span>
          Maple
        </a>
      </div>

    </div>
  </div>

  <div class="projects">
    <p class="section-label">Things I'm building</p>

    <div class="project-item">
      <div class="project-info">
        <h2><a href="https://subtab.app" target="_blank" rel="noopener" class="project-title-link">Subtab <span class="project-arrow">↗</span></a></h2>
        <p>Know exactly what you're paying for. Offline-first subscription tracker, no account needed.</p>
      </div>
    </div>

    <div class="project-item">
      <div class="project-info">
        <h2>The unnamed one</h2>
        <p>Pakistani clothing brands run a lot of sales. Someone should track them. Working on it.</p>
      </div>
    </div>
  </div>

  <div class="connect">
    <p class="section-label">Find me online</p>
    <div class="social-links">
      <a href="https://twitter.com/fahadimran_7" target="_blank" rel="noopener" class="social-link"><Twitter size={17} />Twitter</a>
      <a href="https://github.com/fahadimran7" target="_blank" rel="noopener" class="social-link"><Github size={17} />GitHub</a>
      <a href="https://linkedin.com/in/fahadimran7" target="_blank" rel="noopener" class="social-link"><Linkedin size={17} />LinkedIn</a>
      <a href="mailto:fahadimran6544@gmail.com" class="social-link"><Mail size={17} />Email</a>
    </div>
  </div>

</Base>
