---
import Base from '../layouts/Base.astro';
import ContactCta from '../components/ContactCta.astro';

const books = [
  {
    title: 'Digital Minimalism',
    author: 'Cal Newport',
    url: 'https://calnewport.com/my-new-book-digital-minimalism/',
    image: '/images/books/digital-minimalism.webp',
    width: 1524,
    height: 2339,
  },
  {
    title: 'Smart Parenting for Smart Kids',
    author: 'Eileen Kennedy-Moore & Mark S. Lowenthal',
    url: 'https://eileenkennedymoore.com/child-development-books/smart-parenting-for-smart-kids/',
    image: '/images/books/smart-parenting-for-smart-kids.webp',
    width: 907,
    height: 1360,
  },
  {
    title: 'The Tech-Wise Family',
    author: 'Andy Crouch',
    url: 'https://andy-crouch.com/',
    image: '/images/books/tech-wise-family.webp',
    width: 1429,
    height: 2000,
  },
];

const tripPhotos = [
  {
    src: '/images/trips/alfabolt-offsite.webp',
    width: 1152,
    height: 1536,
    alt: 'The Alfabolt team gathered beside a mountain lake in Kumrat',
    caption: 'Alfabolt trip ’24, Kumrat',
  },
  {
    src: '/images/trips/mahodand-lake.webp',
    width: 1080,
    height: 1350,
    alt: 'The Alfabolt team standing in the snow at Mahodand Lake',
    caption: 'Mahodand Lake, Ushu Valley',
  },
  {
    src: '/images/trips/reboot-2025.webp',
    width: 1080,
    height: 1350,
    alt: 'The Alfabolt team together in the forest during the Reboot 2025 trip',
    caption: 'Reboot ’25, Kalam',
  },
];
---
<Base
  title="About"
  description="Product engineer shipping payment products and startup software across web and mobile from Pakistan."
>

  <div class="page-heading">
    <h1>About</h1>
  </div>

  <p class="intro">
    I fell for the front end early — the instant payoff of building something you can
    actually see and click. So I kept building, started shipping real things, and never
    really stopped. Most of what I know came from shipping, breaking, and quietly fixing
    things before anyone noticed.
  </p>

  <div class="me">
    <figure class="polaroid">
      <img src="/images/profile-portrait.webp" alt="Fahad Imran" width="240" height="288" />
    </figure>

    <div class="me-body">
      <dl class="facts">
        <div class="fact">
          <dt>Currently</dt>
          <dd>
            Software Engineer at
            <a href="https://alfabolt.com" target="_blank" rel="noopener">Alfabolt</a>, building
            <a href="https://nomod.com" target="_blank" rel="noopener">Nomod</a>
          </dd>
        </div>
        <div class="fact">
          <dt>Focus</dt>
          <dd>Payment infrastructure, checkout systems, and product engineering</dd>
        </div>
        <div class="fact">
          <dt>Range</dt>
          <dd>Web and mobile products — from frontend systems to backend integrations</dd>
        </div>
        <div class="fact">
          <dt>Approach</dt>
          <dd>Starts with the product problem, then owns delivery through the edge cases</dd>
        </div>
        <div class="fact">
          <dt>Based</dt>
          <dd>Pakistan 🇵🇰 — working remotely across international teams</dd>
        </div>
      </dl>
    </div>
  </div>

  <section class="bookshelf" aria-labelledby="bookshelf-title">
    <div class="bookshelf-heading">
      <p class="section-label">Away from the keyboard</p>
      <h2 id="bookshelf-title">A few things shaping how I think.</h2>
    </div>

    <div class="carousel-shell book-carousel-shell" data-carousel>
      <div class="book-grid" data-carousel-track>
        {books.map((book) => (
          <a
            class="book-card"
            href={book.url}
            target="_blank"
            rel="noopener"
            aria-label={`${book.title} by ${book.author} (opens in a new tab)`}
          >
            <div class="book-cover">
              <img
                src={book.image}
                alt={`Cover of ${book.title}`}
                width={book.width}
                height={book.height}
                loading="lazy"
              />
            </div>
            <div class="book-details">
              <h3>{book.title}</h3>
              <p>{book.author}</p>
              {book.note && <p class="book-note">{book.note}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <aside class="not-online">
    <div class="not-here" role="list" aria-label="Platforms I've quit">
      <span class="not-here-item" role="listitem" title="Not on X">
        <img src="/logos/x.svg" alt="X" class="brand-x" width="22" height="22" />
      </span>
      <span class="not-here-item" role="listitem" title="Not on Instagram">
        <img src="/logos/instagram.svg" alt="Instagram" width="22" height="22" />
      </span>
      <span class="not-here-item" role="listitem" title="Not on Facebook">
        <img src="/logos/facebook.svg" alt="Facebook" width="22" height="22" />
      </span>
    </div>
    <p class="not-online-text">
      You won't find me on X, Instagram, or Facebook — I deleted them for my sanity, and
      losing the infinite scroll was the closest thing to a software update my brain's ever
      had. I didn't beat the algorithm though; I just picked a favourite, and I'm hopelessly
      addicted to <a href="https://www.youtube.com/" target="_blank" rel="noopener" class="yt-inline"><img src="/logos/youtube.svg" alt="" width="19" height="19" />YouTube</a>.
    </p>
  </aside>

  <section class="trip-gallery" aria-labelledby="trip-gallery-title">
    <div class="trip-gallery-heading">
      <p class="section-label">Offline, together</p>
      <h2 id="trip-gallery-title">Remote, until someone books a bus.</h2>
      <p class="trip-photo-credit">
        Photos borrowed from
        <a href="https://www.linkedin.com/company/alfabolt" target="_blank" rel="noopener">Alfabolt’s LinkedIn</a>.
        I was busy being in them.
      </p>
    </div>

    <div class="carousel-shell trip-carousel-shell" data-carousel>
      <div class="trip-photo-strip" data-carousel-track>
        {tripPhotos.map((photo, index) => (
          <figure class:list={["trip-polaroid", `trip-polaroid--${index + 1}`]}>
            <img
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="lazy"
            />
            <figcaption>
              <span>{photo.caption}</span>
              <span aria-hidden="true">0{index + 1}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <div class="about-cta">
    <ContactCta
      eyebrow="One last thing"
      heading="Back to business."
      copy="If the work feels like a fit, let’s talk."
      buttonLabel="Start a conversation"
    />
  </div>

</Base>

<script>
  // Tilt the polaroid once it scrolls into view, and leave it tilted.
  // Re-run on every client-side navigation, since the element is swapped fresh.
  let polaroidIO = null;
  function initPolaroidTilt() {
    const polaroid = document.querySelector('.polaroid');
    if (!polaroid) return;
    if (polaroidIO) polaroidIO.disconnect();
    polaroidIO = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          polaroid.classList.add('is-tilted');
          if (polaroidIO) polaroidIO.disconnect();
        }
      });
      // Fires only once the photo scrolls up past the middle of the viewport,
      // so the tilt animation is visible even when it's on-screen at load.
    }, { threshold: 0, rootMargin: '0px 0px -50% 0px' });
    polaroidIO.observe(polaroid);
  }
  document.addEventListener('astro:page-load', initPolaroidTilt);

  function initCarousels() {
    document.querySelectorAll('[data-carousel]').forEach(function (shell) {
      const track = shell.querySelector('[data-carousel-track]');
      if (!track || track.dataset.carouselBound) return;
      track.dataset.carouselBound = '1';

      function syncFades() {
        const leftThreshold = 32;
        const rightThreshold = 3;
        shell.classList.toggle('can-scroll-left', track.scrollLeft > leftThreshold);
        shell.classList.toggle(
          'can-scroll-right',
          track.scrollLeft < track.scrollWidth - track.clientWidth - rightThreshold
        );
      }

      track.addEventListener('scroll', syncFades, { passive: true });
      window.addEventListener('resize', syncFades, { passive: true });
      requestAnimationFrame(syncFades);
    });
  }

  document.addEventListener('astro:page-load', initCarousels);
</script>

<style>
  .page-heading {
    margin-bottom: 20px;
  }

  .intro {
    font-size: 18px;
    line-height: 1.6;
    font-weight: 400;
    color: var(--muted);
    margin-bottom: 44px;
  }

  /* ── Photo + current role ── */
  .me {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 64px;
    align-items: start;
    margin-bottom: 64px;
  }

  .polaroid {
    background: #fff;
    padding: 7px;
    border-radius: 3px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.08),
      0 10px 26px rgba(0, 0, 0, 0.12);
    transform: rotate(0deg);
    /* eased so the tilt settles in as it scrolls into view */
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* tilts once when scrolled into view, then stays */
  .polaroid.is-tilted {
    transform: rotate(-3deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .polaroid {
      transition: none;
    }
    .polaroid.is-tilted {
      transform: none;
    }
  }
  .polaroid img {
    display: block;
    width: 100%;
    /* height:auto lets the width/aspect-ratio drive the height. Without it the
       img's height attribute stays fixed while width scales to the column, so
       the ratio breaks after a client-side nav (it's only correct on refresh). */
    height: auto;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    border-radius: 1px;
  }

  .me-body {
    min-width: 0;
    padding-top: 4px;
  }

  .facts {
    margin: 0;
  }
  .fact {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 16px;
    padding: 11px 0;
    border-top: 1px solid var(--border);
    align-items: baseline;
  }
  .fact:first-child {
    border-top: none;
    padding-top: 0;
  }
  .fact dt {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.55;
  }
  .fact dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text);
  }
  .fact dd a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
  }
  .fact dd a:hover {
    text-decoration-color: var(--text);
  }

  /* ── Current reading ── */
  .bookshelf {
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.45fr);
    align-items: start;
    gap: clamp(36px, 7vw, 104px);
    margin: 88px 0;
  }

  .bookshelf-heading {
    position: sticky;
    top: 112px;
  }

  .bookshelf-heading .section-label {
    margin-bottom: 14px;
  }

  .bookshelf-heading h2 {
    max-width: 430px;
    color: color-mix(in srgb, var(--muted) 82%, transparent);
    font-size: clamp(30px, 3.2vw, 44px);
    font-weight: 450;
    line-height: 1.16;
    letter-spacing: -0.038em;
    text-wrap: balance;
  }

  .book-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 132px));
    gap: 24px;
    align-items: start;
    justify-content: start;
  }

  .carousel-shell {
    position: relative;
    min-width: 0;
  }

  .book-card {
    display: block;
    min-width: 0;
    color: var(--text);
    text-decoration: none;
  }

  .book-cover {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    aspect-ratio: 2 / 3;
    margin-bottom: 14px;
    perspective: 900px;
  }

  .book-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 3px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
    transform-origin: center bottom;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 220ms ease;
  }

  .book-details {
    min-width: 0;
  }

  .book-details h3 {
    margin: 0 0 5px;
    font-size: 14px;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .book-details > p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.45;
  }

  .book-details .book-note {
    margin-top: 7px;
    font-size: 11px;
    font-style: italic;
  }

  .book-card:hover .book-cover img {
    transform: translateY(-8px) rotateY(-2deg);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
  }

  .book-card:hover .book-details h3 {
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
  }

  /* ── Where you won't find me ── */
  .not-online {
    margin: 40px 0 52px;
    padding-left: 16px;
    border-left: 2px solid var(--border);
  }

  .not-here {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .not-here-item {
    position: relative;
    display: inline-flex;
    line-height: 0;
  }
  .not-here-item img {
    width: 22px;
    height: 22px;
    filter: grayscale(1);
    opacity: 0.4;
  }
  :global([data-theme="dark"]) .not-here-item img {
    opacity: 0.5;
  }
  /* diagonal "nope" strike across each quit platform */
  .not-here-item::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 30px;
    height: 2px;
    background: var(--muted);
    border-radius: 2px;
    transform: translate(-50%, -50%) rotate(-45deg);
    opacity: 0.7;
  }
  .brand-x {
    filter: grayscale(1);
  }
  :global([data-theme="dark"]) .not-here-item img.brand-x {
    filter: grayscale(1) invert(1);
  }

  .not-online-text {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.65;
  }

  .yt-inline {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
    text-underline-offset: 3px;
  }
  .yt-inline img {
    margin-right: 5px;
    vertical-align: -0.3em;
  }
  .yt-inline:hover {
    text-decoration: underline;
  }

  /* ── Team trips ── */
  .trip-gallery {
    margin: 96px 0 72px;
  }

  .trip-gallery-heading {
    max-width: 680px;
    margin-bottom: 44px;
  }

  .trip-gallery-heading .section-label {
    margin-bottom: 14px;
  }

  .trip-gallery-heading h2 {
    color: var(--muted);
    font-size: clamp(34px, 4.2vw, 54px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .trip-photo-credit {
    margin-top: 16px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .trip-photo-credit a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
  }

  .trip-photo-credit a:hover {
    color: var(--text);
    text-decoration-color: var(--text);
  }

  .trip-photo-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2.6vw, 34px);
    align-items: start;
    padding: 4px 18px 26px;
  }

  .trip-polaroid {
    position: relative;
    margin: 0;
    padding: 10px 10px 18px;
    color: #202020;
    background: #f8f7f2;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 3px;
    box-shadow: none;
    transform-origin: center center;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 240ms ease;
  }

  .trip-polaroid--1 {
    transform: rotate(-2.5deg);
  }

  .trip-polaroid--2 {
    margin-top: 28px;
    transform: rotate(1.7deg);
  }

  .trip-polaroid--3 {
    margin-top: 5px;
    transform: rotate(-1deg);
  }

  .trip-polaroid:hover {
    z-index: 1;
    transform: translateY(-8px) rotate(0deg);
    box-shadow: none;
  }

  .trip-polaroid img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1px;
  }

  .trip-polaroid figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 4px 0;
    font-size: 11px;
    line-height: 1.35;
    letter-spacing: 0.025em;
  }

  .trip-polaroid figcaption span:last-child {
    color: #8b8b87;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 820px) {
    .me {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .polaroid {
      max-width: 240px;
    }
    .me-body {
      width: 100%;
      padding-top: 0;
    }
  }

  @media (max-width: 570px) {
    .me {
      gap: 28px;
      justify-items: center;
    }
    .me-role {
      font-size: 21px;
    }
    .book-grid {
      display: flex;
      gap: 20px;
      width: auto;
      max-width: none;
      padding: 14px 32px 32px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-padding-inline: 32px;
      scroll-snap-type: inline mandatory;
      scrollbar-width: none;
      touch-action: pan-x pan-y;
      -webkit-overflow-scrolling: touch;
    }
    .book-grid::-webkit-scrollbar {
      display: none;
    }
    .book-card {
      flex: 0 0 min(220px, 68vw);
      scroll-snap-align: start;
    }
    .book-carousel-shell,
    .trip-carousel-shell {
      margin-inline: -24px;
      overflow: hidden;
    }
    .carousel-shell::before,
    .carousel-shell::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      z-index: 3;
      width: clamp(52px, 18vw, 78px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 180ms ease;
    }
    .carousel-shell::before {
      left: 0;
      background: linear-gradient(to right, var(--bg) 4%, color-mix(in srgb, var(--bg) 82%, transparent) 38%, transparent 100%);
    }
    .carousel-shell::after {
      right: 0;
      background: linear-gradient(to left, var(--bg) 4%, color-mix(in srgb, var(--bg) 82%, transparent) 38%, transparent 100%);
    }
    .carousel-shell.can-scroll-left::before,
    .carousel-shell.can-scroll-right::after {
      opacity: 1;
    }
    .trip-gallery {
      margin: 76px 0 56px;
    }
    .trip-gallery-heading {
      margin-bottom: 30px;
    }
    .trip-gallery-heading h2 {
      font-size: clamp(32px, 10vw, 42px);
    }
    .trip-photo-strip {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(230px, 78vw);
      gap: 18px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline mandatory;
      scrollbar-width: none;
      padding: 8px 32px 30px;
      scroll-padding-inline: 32px;
      touch-action: pan-x pan-y;
      -webkit-overflow-scrolling: touch;
    }
    .trip-photo-strip::-webkit-scrollbar {
      display: none;
    }
    .trip-polaroid,
    .trip-polaroid--2,
    .trip-polaroid--3 {
      margin-top: 0;
      scroll-snap-align: start;
    }
    .book-card:hover .book-cover img,
    .book-card:active .book-cover img {
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
    }
    .trip-polaroid:hover,
    .trip-polaroid:active {
      box-shadow: none;
    }
  }

  @media (max-width: 900px) {
    .bookshelf {
      grid-template-columns: 1fr;
      gap: 30px;
      margin: 72px 0;
    }
    .bookshelf-heading {
      position: static;
    }
    .bookshelf-heading h2 {
      max-width: 680px;
    }
  }

  @media (min-width: 571px) and (max-width: 900px) {
    .book-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
      width: 100%;
      max-width: 600px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-cover img {
      transition: none;
    }
    .book-card:hover .book-cover img {
      transform: none;
    }
    .trip-polaroid {
      transition: none;
    }
    .trip-polaroid:hover {
      transform: none;
    }
  }

  .about-cta {
    margin-top: 96px;
  }
</style>
