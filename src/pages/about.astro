---
import Base from '../layouts/Base.astro';
import { Download, Mail } from 'lucide-astro';
---
<Base
  title="About"
  description="Five years, four countries, mostly shipping from a bedroom in Pakistan. The short version of how I got here."
>

  <div class="page-heading">
    <h1>About</h1>
  </div>

  <p class="intro">
    I fell for the front end early — the instant payoff of building something you can
    actually see and click. So I kept building, started shipping real things, and never
    really stopped. Most of what I know came from shipping, breaking, and quietly fixing
    things before anyone noticed.
  </p>

  <aside class="not-online">
    <div class="not-here" role="list" aria-label="Platforms I've quit">
      <span class="not-here-item" role="listitem" title="Not on X">
        <img src="/logos/x.svg" alt="X" class="brand-x" width="22" height="22" />
      </span>
      <span class="not-here-item" role="listitem" title="Not on Instagram">
        <img src="/logos/instagram.svg" alt="Instagram" width="22" height="22" />
      </span>
      <span class="not-here-item" role="listitem" title="Not on Facebook">
        <img src="/logos/facebook.svg" alt="Facebook" width="22" height="22" />
      </span>
    </div>
    <p class="not-online-text">
      You won't find me on X, Instagram, or Facebook — I deleted them for my sanity, and
      losing the infinite scroll was the closest thing to a software update my brain's ever
      had. I didn't beat the algorithm though; I just picked a favourite, and I'm hopelessly
      addicted to <a href="https://www.youtube.com/" target="_blank" rel="noopener" class="yt-inline"><img src="/logos/youtube.svg" alt="" width="19" height="19" />YouTube</a>.
    </p>
  </aside>

  <div class="me">
    <figure class="polaroid">
      <img src="/images/profile-photo.webp" alt="Fahad Imran" width="240" height="288" />
    </figure>

    <div class="me-body">
      <dl class="facts">
        <div class="fact">
          <dt>Now</dt>
          <dd>
            Software Engineer, building
            <a href="https://nomod.com" target="_blank" rel="noopener">Nomod</a>
            @ <a href="https://alfabolt.com" target="_blank" rel="noopener">Alfabolt</a>
          </dd>
        </div>
        <div class="fact">
          <dt>Before</dt>
          <dd>Six products, four countries — <a href="/work">the whole run</a></dd>
        </div>
        <div class="fact">
          <dt>Based</dt>
          <dd>Pakistan, remote-first since 2021</dd>
        </div>
        <div class="fact">
          <dt>Does</dt>
          <dd>Ships the whole feature — design, edge cases, the boring 20%</dd>
        </div>
      </dl>
      <div class="me-actions">
        <a class="btn-ghost" href="/resume.pdf" download="Fahad-Imran-Resume.pdf">
          <Download size={15} /> resume
        </a>
        <a class="btn-solid" href="mailto:fahadimran6544@gmail.com">
          <Mail size={15} /> connect
        </a>
      </div>
    </div>
  </div>

</Base>

<script>
  // Tilt the polaroid once it scrolls into view, and leave it tilted.
  // Re-run on every client-side navigation, since the element is swapped fresh.
  let polaroidIO = null;
  function initPolaroidTilt() {
    const polaroid = document.querySelector('.polaroid');
    if (!polaroid) return;
    if (polaroidIO) polaroidIO.disconnect();
    polaroidIO = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          polaroid.classList.add('is-tilted');
          if (polaroidIO) polaroidIO.disconnect();
        }
      });
      // Fires only once the photo scrolls up past the middle of the viewport,
      // so the tilt animation is visible even when it's on-screen at load.
    }, { threshold: 0, rootMargin: '0px 0px -50% 0px' });
    polaroidIO.observe(polaroid);
  }
  document.addEventListener('astro:page-load', initPolaroidTilt);
</script>

<style>
  .page-heading {
    margin-bottom: 20px;
  }

  .intro {
    font-size: 18px;
    line-height: 1.6;
    font-weight: 400;
    color: var(--muted);
    max-width: 680px;
    margin-bottom: 44px;
  }

  /* ── Photo + current role ── */
  .me {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 64px;
    align-items: start;
    margin-bottom: 64px;
  }

  .polaroid {
    background: #fff;
    padding: 7px;
    border-radius: 3px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.08),
      0 10px 26px rgba(0, 0, 0, 0.12);
    transform: rotate(0deg);
    /* eased so the tilt settles in as it scrolls into view */
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* tilts once when scrolled into view, then stays */
  .polaroid.is-tilted {
    transform: rotate(-3deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .polaroid {
      transition: none;
    }
    .polaroid.is-tilted {
      transform: none;
    }
  }
  .polaroid img {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    border-radius: 1px;
  }

  .me-body {
    min-width: 0;
    padding-top: 4px;
  }

  .facts {
    margin: 0;
  }
  .fact {
    display: grid;
    grid-template-columns: 66px 1fr;
    gap: 16px;
    padding: 11px 0;
    border-top: 1px solid var(--border);
    align-items: baseline;
  }
  .fact:first-child {
    border-top: none;
    padding-top: 0;
  }
  .fact dt {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.55;
  }
  .fact dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text);
  }
  .fact dd a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
  }
  .fact dd a:hover {
    text-decoration-color: var(--text);
  }

  .me-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
  }

  /* ── Where you won't find me ── */
  .not-online {
    margin: 40px 0 52px;
    padding-left: 16px;
    border-left: 2px solid var(--border);
  }

  .not-here {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .not-here-item {
    position: relative;
    display: inline-flex;
    line-height: 0;
  }
  .not-here-item img {
    width: 22px;
    height: 22px;
    filter: grayscale(1);
    opacity: 0.4;
  }
  :global([data-theme="dark"]) .not-here-item img {
    opacity: 0.5;
  }
  /* diagonal "nope" strike across each quit platform */
  .not-here-item::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 30px;
    height: 2px;
    background: var(--muted);
    border-radius: 2px;
    transform: translate(-50%, -50%) rotate(-45deg);
    opacity: 0.7;
  }
  .brand-x {
    filter: grayscale(1);
  }
  :global([data-theme="dark"]) .not-here-item img.brand-x {
    filter: grayscale(1) invert(1);
  }

  .not-online-text {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.65;
    max-width: 560px;
  }

  .yt-inline {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
    text-underline-offset: 3px;
  }
  .yt-inline img {
    margin-right: 5px;
    vertical-align: -0.3em;
  }
  .yt-inline:hover {
    text-decoration: underline;
  }

  @media (max-width: 570px) {
    .me {
      grid-template-columns: 1fr;
      gap: 28px;
      justify-items: center;
    }
    .polaroid {
      max-width: 240px;
    }
    .me-body {
      padding-top: 0;
    }
    .me-role {
      font-size: 21px;
    }
  }
</style>
