---
import Base from '../layouts/Base.astro';
import { Twitter, Youtube, BookOpen, Link2 } from 'lucide-astro';

const bookmarks = [
  {
    type: "tweet",
    title: "It's 2018 and your coworker just sent you a 400 line pull request",
    url: "https://x.com/i/status/2054152429277421773",
    note: "wrote a whole rambling about this one",
  },
  {
    type: "tweet",
    title: "Why 90% of Vibe Coded Apps Look Cheap (And Exactly How to Fix It)",
    url: "https://x.com/i/status/2034890067236594136",
    note: "you can tell in 3 seconds. correct.",
  },
  {
    type: "tweet",
    title: "At WorkOS, Everyone Codes",
    url: "https://x.com/i/status/2047394537203736825",
    note: "coding as basic executive function. i think they're right.",
  },
  {
    type: "video",
    title: "Why Vibe Coders Can't Build Useful Apps",
    url: "https://www.youtube.com/watch?v=2IQYbwQpFdM",
    note: "honest title. watched it twice.",
  },
  {
    type: "tweet",
    title: "Day shift plans. Night shift ships. A real playbook for AFK agents.",
    url: "https://x.com/mattpocockuk/status/2048159313357598989",
    note: "closest thing to an actual workflow for AFK coding i've seen.",
  },
];

const iconMap: Record<string, any> = {
  tweet: Twitter,
  video: Youtube,
  article: BookOpen,
};
---
<Base title="Reads" description="A small collection of useful ideas, articles, and videos worth revisiting.">

  <style is:global>
    .reads-list { margin-bottom: 56px; }

    .reads-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 16px 0;
      border-top: 1px solid var(--border);
    }

    .reads-item:last-child { border-bottom: 1px solid var(--border); }

    .reads-type {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      flex-shrink: 0;
      padding: 4px 8px;
      border-radius: 6px;
      background: var(--chip-bg);
      border: 1px solid var(--border);
      color: var(--muted);
      margin-top: 2px;
    }

    .reads-type[data-type="tweet"] {
      color: #1d9bf0;
      background: rgba(29, 155, 240, 0.07);
      border-color: rgba(29, 155, 240, 0.14);
    }

    .reads-type[data-type="video"] {
      color: #ef4444;
      background: rgba(239, 68, 68, 0.07);
      border-color: rgba(239, 68, 68, 0.14);
    }

    [data-theme="dark"] .reads-type[data-type="tweet"] {
      background: rgba(29, 155, 240, 0.10);
      border-color: rgba(29, 155, 240, 0.18);
    }

    [data-theme="dark"] .reads-type[data-type="video"] {
      background: rgba(239, 68, 68, 0.10);
      border-color: rgba(239, 68, 68, 0.18);
    }

    .reads-body {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .reads-body a {
      font-size: 18px;
      font-weight: 650;
      letter-spacing: -0.01em;
      color: var(--text);
      text-decoration: none;
      line-height: 1.4;
    }

    .reads-body a:hover { text-decoration: underline; }

    .reads-note {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.5;
      margin: 0;
    }

    @media (max-width: 415px) {
      .reads-item {
        flex-direction: column;
        gap: 8px;
      }

      .reads-body {
        width: 100%;
        order: 1;
      }

      .reads-type {
        order: 2;
        margin-top: 0;
        align-self: flex-start;
      }
    }
  </style>

  <div class="page-heading">
    <h1>Reads</h1>
    <p>A small collection of useful ideas, articles, and videos that are worth revisiting.</p>
  </div>

  <div class="reads-list">
    {bookmarks.map(b => {
      const Icon = iconMap[b.type] || Link2;
      return (
        <div class="reads-item">
          <span class="reads-type" data-type={b.type}>
            <Icon size={12} />
            {b.type}
          </span>
          <div class="reads-body">
            <a href={b.url} target="_blank" rel="noopener">{b.title}</a>
            {b.note && <p class="reads-note">{b.note}</p>}
          </div>
        </div>
      );
    })}
  </div>

</Base>
