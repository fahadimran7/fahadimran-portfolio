---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { CalendarDays, Clock3, ArrowLeft, ChevronLeft, ChevronRight } from 'lucide-astro';

export async function getStaticPaths() {
  const posts = await getCollection('ramblings', ({ data }) => data.published);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(str: string) {
  return new Date(str).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

function readingTime(body: string) {
  return `${Math.ceil(body.trim().split(/\s+/).length / 200)} min read`;
}

// Prev/next follow the same newest-first order as /ramblings, so adjacency
// here always matches the list — "previous" is the post shown above this one
// there, "next" is the post shown below.
const allPosts = (await getCollection('ramblings', ({ data }) => data.published)).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);
const currentIndex = allPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : undefined;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : undefined;
---
<Base title={post.data.title} description={post.data.summary} ogImage={`/og/${post.id}.png`}>

  <style is:global>
    /* ── Back to index ── */
    .post-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 28px;
      padding: 9px 12px;
      border: 1px solid var(--border);
      font-size: 14px;
      font-weight: 400;
      color: var(--muted);
      text-decoration: none;
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .post-back:hover {
      color: var(--text);
      border-color: color-mix(in srgb, var(--text) 30%, var(--border));
    }
    /* Nudge the arrow left on hover, mirroring the post-nav links' nudge. */
    .post-back svg {
      transition: transform 0.15s ease;
    }
    .post-back:hover svg {
      transform: translateX(-3px);
    }

    .post-title {
      font-size: 38px;
      font-weight: 700;
      line-height: 1.12;
      letter-spacing: -0.03em;
      margin-bottom: 18px;
    }

    .post-meta {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 14px;
      color: var(--muted);
      margin-bottom: 48px;
    }

    .post-meta span {
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .post-meta .sep { font-size: 10px; }

    .post-body {
      font-size: 18px;
      line-height: 1.8;
      /* Slightly softer than headings, so body recedes and headings lead. */
      color: color-mix(in srgb, var(--text) 90%, var(--bg));
    }

    .post-body p { margin-bottom: 28px; }
    .post-body p:last-child { margin-bottom: 0; }

    .post-body ul,
    .post-body ol {
      margin: 0 0 28px;
      padding-left: 24px;
    }
    .post-body li { margin-bottom: 10px; }
    .post-body li:last-child { margin-bottom: 0; }
    .post-body li::marker { color: var(--muted); }

    .post-body h2 {
      font-size: 25px;
      font-weight: 700;
      margin-top: 60px;
      margin-bottom: 16px;
      letter-spacing: -0.02em;
      color: var(--text);
      line-height: 1.3;
    }

    .post-body a {
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .post-body img,
    .post-body video {
      width: 100%;
      border-radius: 10px;
      margin: 32px 0;
      display: block;
    }

    /* ── Figures with captions ── */
    .post-body figure {
      margin: 32px 0;
    }

    .post-body figure img,
    .post-body figure video {
      margin: 0;
    }

    /* Portrait phone screenshots / recordings shouldn't span the full column */
    .post-body figure.phone {
      max-width: 300px;
      margin-left: auto;
      margin-right: auto;
    }

    .post-body figcaption {
      font-size: 14px;
      line-height: 1.55;
      color: var(--muted);
      text-align: center;
      margin-top: 12px;
    }

    /* ── Code ── */
    .post-body :not(pre) > code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 0.86em;
      padding: 2px 6px;
      border-radius: 5px;
      background: var(--chip-bg);
      border: 1px solid var(--border);
    }
    .post-body pre {
      margin: 28px 0;
      padding: 16px 18px;
      border-radius: 10px;
      background: var(--chip-bg);
      border: 1px solid var(--border);
      overflow-x: auto;
      font-size: 13.5px;
      line-height: 1.6;
    }
    .post-body pre code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      background: none;
      border: none;
      padding: 0;
    }
    /* Shiki dual-theme token colours, switched by the site's [data-theme] toggle.
       We keep our own block background above and only take Shiki's token colours. */
    .post-body .astro-code,
    .post-body .astro-code span {
      color: var(--shiki-light);
    }
    [data-theme="dark"] .post-body .astro-code,
    [data-theme="dark"] .post-body .astro-code span {
      color: var(--shiki-dark);
    }

    /* Copy button (injected around each code block by the script below) */
    .post-body .code-block {
      position: relative;
      margin: 28px 0;
    }
    .post-body .code-block pre {
      margin: 0;
    }
    .code-copy-btn {
      position: absolute;
      top: 9px;
      right: 9px;
      display: inline-flex;
      align-items: center;
      font-family: inherit;
      font-size: 12px;
      line-height: 1;
      color: var(--muted);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 5px 9px;
      cursor: pointer;
      transition: color 0.15s ease;
    }
    .code-copy-btn:hover { color: var(--text); }
    .code-copy-btn svg { margin-right: 5px; }
    .code-copy-btn.is-copied { opacity: 1; }
    .code-copy-btn.is-copied svg { color: hsl(145 55% 38%); }
    [data-theme="dark"] .code-copy-btn.is-copied svg { color: hsl(145 58% 62%); }

    /* ── Blockquote / callout ── */
    .post-body blockquote {
      margin: 0 0 28px;
      padding: 14px 20px;
      border-left: 3px solid var(--border);
      color: var(--muted);
      font-size: 15.5px;
      line-height: 1.65;
    }
    .post-body blockquote p { margin-bottom: 12px; }
    .post-body blockquote p:last-child { margin-bottom: 0; }

    /* ── Tables ── */
    .post-body table {
      width: 100%;
      border-collapse: collapse;
      margin: 28px 0;
      font-size: 15px;
      line-height: 1.5;
    }
    .post-body th,
    .post-body td {
      text-align: left;
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }
    .post-body th {
      font-weight: 600;
      font-size: 12.5px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--muted);
    }
    .post-body tbody tr:last-child td { border-bottom: none; }
    .post-body table strong { font-weight: 650; }

    /* ── Coloured chips inside inline SVG diagrams ── */
    .post-body svg .dchip rect {
      fill: hsl(var(--h) 65% 94%);
      stroke: hsl(var(--h) 55% 87%);
    }
    .post-body svg .dchip text {
      fill: hsl(var(--h) 48% 32%);
    }
    [data-theme="dark"] .post-body svg .dchip rect {
      fill: hsl(var(--h) 28% 17%);
      stroke: hsl(var(--h) 25% 28%);
    }
    [data-theme="dark"] .post-body svg .dchip text {
      fill: hsl(var(--h) 62% 76%);
    }

    /* ── Post reading column: restrained width, centered inside the wider
       site wrap (which stays wide for every other page). ── */
    .post-shell {
      max-width: 760px;
      margin: 0 auto;
    }

    /* ── Prev / next ── */
    .post-nav {
      margin-top: 56px;
      padding-top: 24px;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      gap: 24px;
    }

    .post-nav-link {
      display: flex;
      align-items: center;
      gap: 10px;
      max-width: 46%;
      min-width: 0;
      color: var(--muted);
      text-decoration: none;
    }

    .post-nav-next {
      margin-left: auto;
      text-align: right;
    }

    .post-nav-text {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
    }

    .post-nav-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
    }

    .post-nav-title {
      font-size: 15px;
      color: var(--muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: color 0.15s ease;
    }

    .post-nav-link:hover .post-nav-title {
      color: var(--text);
    }

    .post-nav-link svg {
      flex-shrink: 0;
      color: var(--muted);
      transition: transform 0.15s ease;
    }
    /* The chevron glyph sits ~6px inset from its own SVG box on every side
       (Lucide's viewBox is wider than the stroke) — pull it back out on the
       outward-facing edge so the arrow reads flush with the card, not padded. */
    .post-nav-prev svg {
      margin-left: -6px;
    }
    .post-nav-next svg {
      margin-right: -6px;
    }
    .post-nav-prev:hover svg {
      transform: translateX(-3px);
    }
    .post-nav-next:hover svg {
      transform: translateX(3px);
    }

    @media (max-width: 570px) {
      .post-nav-link {
        max-width: 48%;
      }
      .post-nav-title {
        white-space: normal;
        overflow: visible;
        text-overflow: clip;
      }
    }
  </style>

  <div class="post-shell">
    <a class="post-back" href="/ramblings">
      <ArrowLeft size={15} strokeWidth={2} />
      Ramblings
    </a>

    <h1 class="post-title">{post.data.title}</h1>

    <div class="post-meta">
      <span>
        <CalendarDays size={14} strokeWidth={1.75} />
        {formatDate(post.data.publishedAt)}
      </span>
      <span class="sep">·</span>
      <span>
        <Clock3 size={14} strokeWidth={1.75} />
        {readingTime(post.body)}
      </span>
    </div>

    <div class="post-body">
      <Content />
    </div>

    <nav class="post-nav" aria-label="More ramblings">
      {prevPost ? (
        <a class="post-nav-link post-nav-prev" href={`/ramblings/${prevPost.id}`}>
          <ChevronLeft size={16} strokeWidth={2} />
          <span class="post-nav-text">
            <span class="post-nav-label">Previous</span>
            <span class="post-nav-title">{prevPost.data.title}</span>
          </span>
        </a>
      ) : <span />}
      {nextPost ? (
        <a class="post-nav-link post-nav-next" href={`/ramblings/${nextPost.id}`}>
          <span class="post-nav-text">
            <span class="post-nav-label">Next</span>
            <span class="post-nav-title">{nextPost.data.title}</span>
          </span>
          <ChevronRight size={16} strokeWidth={2} />
        </a>
      ) : <span />}
    </nav>
  </div>

  <script>
    // Wrap each code block and add a copy button that flips to "Copied" briefly.
    // Runs on every client-side navigation; the .code-block guard makes it idempotent.
    function initCodeCopy() {
      const copyIcon = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="13" height="13" x="9" y="9" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      const checkIcon = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
      document.querySelectorAll('.post-body pre').forEach((pre) => {
        if (pre.parentElement && pre.parentElement.classList.contains('code-block')) return;
        const wrap = document.createElement('div');
        wrap.className = 'code-block';
        pre.parentNode.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-copy-btn';
        btn.setAttribute('aria-label', 'Copy code');
        btn.innerHTML = copyIcon + 'Copy';

        let timer;
        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code');
          const text = code ? code.innerText : pre.innerText;
          try {
            await navigator.clipboard.writeText(text);
          } catch (e) {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); } catch (_) {}
            document.body.removeChild(ta);
          }
          btn.innerHTML = checkIcon + 'Copied';
          btn.classList.add('is-copied');
          clearTimeout(timer);
          timer = setTimeout(() => {
            btn.innerHTML = copyIcon + 'Copy';
            btn.classList.remove('is-copied');
          }, 1800);
        });

        wrap.appendChild(btn);
      });
    }

    document.addEventListener('astro:page-load', initCodeCopy);
  </script>

</Base>
