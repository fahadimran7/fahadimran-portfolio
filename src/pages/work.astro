---
import Base from '../layouts/Base.astro';
import { ArrowUpRight } from 'lucide-astro';

interface Position {
  role: string;
  employer?: string;
  start: string;
  end: string;
}

interface Company {
  company: string;
  logo: string;
  url?: string;
  location: string;
  remote?: boolean;
  positions: Position[];
}

// Reverse-chronological. Multiple roles at the same company are grouped
// under one logo (LinkedIn-style); positions are newest-first.
const companies: Company[] = [
  {
    company: 'Nomod',
    logo: '/images/nomod-logo.webp',
    url: 'https://nomod.com',
    location: 'United Arab Emirates',
    remote: true,
    positions: [
      { role: 'Software Engineer', employer: 'Alfabolt', start: 'Jun 2024', end: 'Present' },
    ],
  },
  {
    company: 'Pine',
    logo: '/images/pine-logo.webp',
    url: 'https://apps.apple.com/no/app/pine-the-app/id6467567252',
    location: 'Norway',
    remote: true,
    positions: [
      { role: 'Software Engineer', employer: 'Alfabolt', start: 'Nov 2023', end: 'Jun 2024' },
    ],
  },
  {
    company: 'Rayne',
    logo: '/images/rayne-logo.webp',
    url: 'https://wearerayne.com',
    location: 'United Arab Emirates',
    remote: true,
    positions: [
      { role: 'Frontend Engineer', employer: 'Alfabolt', start: 'Aug 2023', end: 'Nov 2023' },
    ],
  },
  {
    company: 'Leaf',
    logo: '/images/leaf-logo.webp',
    url: 'https://sharewithleaf.com',
    location: 'United States',
    remote: true,
    positions: [
      { role: 'Software Engineer', employer: 'Devsinc', start: 'Jan 2023', end: 'Aug 2023' },
    ],
  },
  {
    company: 'Maple',
    logo: '/images/maple-logo.webp',
    url: 'https://www.linkedin.com/company/maplehr',
    location: 'Pakistan',
    positions: [
      { role: 'Software Engineer', employer: 'Devsinc', start: 'Aug 2022', end: 'Mar 2023' },
    ],
  },
  {
    company: 'Tuamify',
    logo: '/images/tuamify-logo.webp',
    url: 'https://www.linkedin.com/company/tuamify',
    location: 'Pakistan',
    positions: [
      { role: 'Frontend Engineer', start: 'Sep 2021', end: 'Apr 2022' },
    ],
  },
];

const employerUrls: Record<string, string> = {
  Alfabolt: 'https://alfabolt.com',
  Devsinc: 'https://devsinc.com',
};

const span = (positions: Position[]) =>
  positions.length > 1
    ? `${positions[positions.length - 1].start} — ${positions[0].end}`
    : `${positions[0].start} — ${positions[0].end}`;
---
<Base
  title="Work"
  description="A loosely chronological list of places that let me ship things. Fintech in the UAE, food in Norway, and a few stops I'm still fond of."
>

  <div class="page-heading exp-heading">
    <h1>Work</h1>
    <a class="exp-resume" href="https://linkedin.com/in/fahadimran7" target="_blank" rel="noopener">
      Résumé <ArrowUpRight size={15} />
    </a>
    <p>Five years, four countries, mostly remote from a bedroom in Pakistan. Here's roughly<br class="hb" />where the time went.</p>
  </div>

  <ol class="timeline">
    {companies.map((c) => (
      <li class="tl-item">
        <span class="tl-marker">
          <img src={c.logo} alt={c.company} loading="lazy" />
        </span>
        <div class="tl-body">
          <div class="tl-row">
            <h2 class="tl-company">
              {c.url
                ? <a href={c.url} target="_blank" rel="noopener">{c.company}</a>
                : c.company}
            </h2>
            <span class="tl-dates">{span(c.positions)}</span>
          </div>

          {c.positions.length > 1 ? (
            <ul class="tl-roles">
              {c.positions.map((p) => (
                <li class="tl-role-row">
                  <span class="tl-role">
                    {p.role}{p.employer && (
                      <span class="tl-via"> · via {employerUrls[p.employer]
                        ? <a href={employerUrls[p.employer]} target="_blank" rel="noopener">{p.employer}</a>
                        : p.employer}</span>
                    )}
                  </span>
                  <span class="tl-role-dates">{p.start} — {p.end}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="tl-role">
              {c.positions[0].role}
              {c.positions[0].employer && (
                <span class="tl-via"> · via {employerUrls[c.positions[0].employer]
                  ? <a href={employerUrls[c.positions[0].employer]} target="_blank" rel="noopener">{c.positions[0].employer}</a>
                  : c.positions[0].employer}</span>
              )}
            </p>
          )}

          <p class="tl-loc">{c.remote && <span class="tl-remote">Remote</span>}{c.remote && ' · '}{c.location}</p>
        </div>
      </li>
    ))}
  </ol>

</Base>

<style>
  .exp-heading {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 16px;
    align-items: baseline;
  }
  .exp-heading h1 {
    grid-column: 1;
  }
  .exp-heading p {
    grid-column: 1 / -1;
    max-width: none;
  }

  .exp-resume {
    grid-column: 2;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .exp-resume:hover {
    color: var(--text);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tl-item {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 18px;
    padding-bottom: 34px;
  }
  .tl-item:last-child {
    padding-bottom: 0;
  }

  /* connecting line — from below this marker down to the next */
  .tl-item::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 44px;
    bottom: -6px;
    width: 2px;
    background: var(--border);
  }
  .tl-item:last-child::before {
    display: none;
  }

  .tl-marker {
    position: relative;
    z-index: 1;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    border: 1px solid var(--border);
    background: var(--chip-bg);
    box-shadow: var(--chip-shadow);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .tl-marker img {
    width: 30px;
    height: 30px;
    object-fit: contain;
    display: block;
  }

  .tl-body {
    min-width: 0;
    padding-top: 1px;
  }

  .tl-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .tl-company {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
  }
  .tl-company a {
    color: var(--text);
    text-decoration: none;
  }
  .tl-company a:hover {
    text-decoration: underline;
  }

  .tl-dates {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .tl-role {
    font-size: 16px;
    color: var(--text);
    margin-top: 1px;
  }
  .tl-via {
    color: var(--muted);
  }
  .tl-via a {
    color: var(--muted);
    text-decoration: none;
  }
  .tl-via a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  /* grouped roles under one company */
  .tl-roles {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
  }
  .tl-role-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 3px 0;
  }
  .tl-role-row .tl-role {
    margin-top: 0;
  }
  .tl-role-dates {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .tl-loc {
    font-size: 13px;
    color: var(--muted);
    margin-top: 6px;
    opacity: 0.85;
  }

  @media (max-width: 570px) {
    .hb {
      display: none;
    }
    .tl-item {
      grid-template-columns: 38px 1fr;
      gap: 14px;
    }
    .tl-item::before {
      left: 18px;
      top: 38px;
    }
    .tl-marker {
      width: 38px;
      height: 38px;
      border-radius: 10px;
    }
    .tl-marker img {
      width: 26px;
      height: 26px;
    }
    .tl-row {
      flex-direction: column;
      gap: 2px;
    }
    .tl-role-row {
      flex-direction: column;
      gap: 1px;
    }
  }
</style>
