---
import Base from '../layouts/Base.astro';
import { ArrowRight, Download } from 'lucide-astro';

interface Project {
  name: string;
  description: string;
  url: string;
  urlLabel: string;
  image: string;
  downloadUrl?: string;
  downloadLabel?: string;
}

// First project renders as the featured block; the rest fall into the grid.
const projects: Project[] = [
  {
    name: 'Mizan',
    description:
      "Got tired of doing my zakat in a spreadsheet every year, so I built an app for it. Add your assets, it grabs the gold rate and works out what you owe. Expo, Android first.",
    url: 'https://github.com/fahadimran7/mizan',
    urlLabel: 'github.com/fahadimran7/mizan',
    image: '/images/projects/mizan.png',
    downloadUrl: 'https://github.com/fahadimran7/mizan/releases/latest',
    downloadLabel: 'Download APK',
  },
];

const [featured, ...rest] = projects;
---
<Base
  title="Projects"
  description="Side projects and things I've built because I wanted them to exist. Some shipped, some are still half-finished."
>

  <div class="page-heading">
    <h1>Projects</h1>
    <p>Things I've built, mostly because I wanted them to exist. Some shipped, some are still half-finished.</p>
  </div>

  <hr class="proj-top-rule" aria-hidden="true" />

  {featured && (
    <article class="proj-featured">
      <div class="proj-featured-body">
        <div class="proj-text">
          <h2><a href={featured.url} target="_blank" rel="noopener">{featured.name}</a></h2>
          <p class="proj-desc">{featured.description}</p>
          <div class="proj-links">
            <a class="proj-link" href={featured.url} target="_blank" rel="noopener">
              {featured.urlLabel} <ArrowRight size={15} />
            </a>
            {featured.downloadUrl && (
              <a class="proj-link proj-download" href={featured.downloadUrl} target="_blank" rel="noopener">
                <Download size={15} /> {featured.downloadLabel}
              </a>
            )}
          </div>
        </div>
        <a class="proj-media" href={featured.url} target="_blank" rel="noopener">
          <img src={featured.image} alt={`${featured.name} app icon`} loading="lazy" />
        </a>
      </div>
    </article>
  )}

  {rest.length > 0 && (
    <div class="proj-grid">
      {rest.map((p, i) => (
        <article class="proj-card">
          <div class="proj-card-head">
            <span class="proj-icon"><img src={p.image} alt={`${p.name} icon`} loading="lazy" /></span>
            <h3><a href={p.url} target="_blank" rel="noopener">{p.name}</a></h3>
          </div>
          <p class="proj-desc">{p.description}</p>
          <a class="proj-link" href={p.url} target="_blank" rel="noopener">
            {p.urlLabel} <ArrowRight size={14} />
          </a>
        </article>
      ))}
    </div>
  )}

</Base>

<style>
  .proj-top-rule {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0 0 48px;
  }

  /* ── Featured ── */
  .proj-featured {
    margin-bottom: 56px;
  }

  .proj-featured-body {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 40px;
    align-items: center;
  }

  .proj-text h2 {
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 14px;
    line-height: 1.2;
  }
  .proj-text h2 a {
    color: var(--text);
    text-decoration: none;
    background-image: linear-gradient(var(--text), var(--text));
    background-size: 100% 1.5px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    padding-bottom: 2px;
  }
  .proj-text h2 a:hover {
    opacity: 0.7;
  }

  .proj-media {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--chip-shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .proj-media:hover {
    transform: translateY(-3px);
    box-shadow: var(--chip-shadow-hover);
  }
  .proj-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Grid ── */
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 36px;
  }

  .proj-card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .proj-icon {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--chip-bg);
    box-shadow: var(--chip-shadow);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }
  .proj-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .proj-card-head h3 {
    font-size: 19px;
    font-weight: 600;
  }
  .proj-card-head h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .proj-card-head h3 a:hover {
    text-decoration: underline;
  }

  /* ── Shared ── */
  .proj-desc {
    font-size: 16px;
    color: var(--muted);
    margin-bottom: 18px;
  }

  .proj-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 24px;
  }

  .proj-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    color: var(--text);
    text-decoration: none;
    transition: gap 0.18s ease;
  }
  .proj-link :global(svg) {
    color: var(--muted);
    transition: transform 0.18s ease;
  }
  .proj-link:hover :global(svg) {
    transform: translateX(3px);
  }
  /* Download link leads with its icon — nudge it down, not sideways. */
  .proj-download:hover :global(svg) {
    transform: translateY(2px);
  }

  @media (max-width: 570px) {
    .proj-featured-body {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .proj-media {
      max-width: 240px;
    }
    .proj-text h2 {
      font-size: 24px;
    }
    .proj-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
