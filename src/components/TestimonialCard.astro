---
import type { Testimonial } from '../data/testimonials';

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<article class="testimonial-card">
  <span class="quote-mark" aria-hidden="true">“</span>
  <blockquote>
    <p>{testimonial.quote}</p>
  </blockquote>

  <div class="testimonial-attribution">
    <div>
      <p class="testimonial-name">{testimonial.name}</p>
      <p class="testimonial-role">{testimonial.role} @ {testimonial.company}</p>
    </div>
    <a
      class="linkedin-link"
      href={testimonial.linkedinUrl}
      target="_blank"
      rel="noopener"
      aria-label={`View ${testimonial.name} on LinkedIn`}
      title={`View ${testimonial.name} on LinkedIn`}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.98h3.42v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.41a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.1 20.45H3.54V8.98H7.1v11.47Z" />
      </svg>
    </a>
  </div>
</article>

<style>
  .testimonial-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(28px, 4vw, 52px);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--chip-bg);
    box-shadow: var(--chip-shadow);
  }

  .quote-mark {
    height: 48px;
    color: var(--accent);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 76px;
    line-height: 0.95;
    opacity: 0.88;
  }

  blockquote {
    margin-top: 12px;
  }

  blockquote p {
    color: var(--text);
    font-size: clamp(18px, 1.65vw, 22px);
    line-height: 1.58;
    letter-spacing: -0.014em;
  }

  .testimonial-attribution {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .testimonial-name {
    color: var(--text);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
  }

  .testimonial-role {
    margin-top: 3px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.45;
  }

  .linkedin-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 2px;
    background: #0a66c2;
    color: #fff;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .linkedin-link svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

  .linkedin-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(10, 102, 194, 0.28);
  }

  .linkedin-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 570px) {
    blockquote p {
      font-size: 18px;
    }

    .testimonial-attribution {
      margin-top: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .linkedin-link {
      transition: none;
    }
  }
</style>
