---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  variant?: 'featured' | 'standard';
}

const { project, variant = 'standard' } = Astro.props;
const Tag = project.url ? 'a' : 'div';
const summary = variant === 'featured' && project.featuredSummary
  ? project.featuredSummary
  : project.description;
---

<Tag
  class:list={['project-card', `project-card--${variant}`]}
  href={project.url}
  target={project.url ? '_blank' : undefined}
  rel={project.url ? 'noopener' : undefined}
>
  <div class="project-image-wrap">
    <img src={project.image} alt={`${project.name} product preview`} loading="lazy" />
    {variant !== 'featured' && (
      <>
        <div class="project-overlay">
          <div class="overlay-summary">
            <h2 class="project-title">{project.name}</h2>
            <div class="project-tags" aria-label={`${project.name} categories`}>
              {project.tags.map((tag, index) => (
                <span class:list={['project-tag', { 'project-tag--primary': index === 0 }]}>{tag}</span>
              ))}
            </div>
          </div>

          <div class="overlay-details">
            <p class="project-role">
              {project.role}{project.employer && <> · {project.employer}</>}
            </p>
            <p class="project-desc">{summary}</p>
            <p class="project-context project-context--overlay">
              {project.start}–{project.end} · {project.location}{project.remote && <> · Remote</>}
            </p>
          </div>
        </div>
      </>
    )}
  </div>

  {variant === 'featured' && (
    <div class="project-info">
      <h2 class="project-title">{project.name}</h2>
      <p class="project-role">
        {project.role}{project.employer && <> · {project.employer}</>}
      </p>
    </div>
  )}
</Tag>

<style>
  .project-card {
    display: block;
    color: inherit;
    text-decoration: none;
    min-width: 0;
  }

  .project-image-wrap {
    position: relative;
    isolation: isolate;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--chip-bg);
    border: 1px solid var(--border);
    box-shadow: var(--chip-shadow);
    margin-bottom: 16px;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .project-card:hover .project-image-wrap,
  .project-card:focus-visible .project-image-wrap {
    box-shadow: var(--chip-shadow-hover);
    transform: translateY(-2px);
  }

  /* Homepage cards get a deliberately quiet hover cue. Opacity is cheap for
     the compositor to animate and avoids applying a filter to the image. */
  .project-card--featured .project-image-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.07);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .project-card--featured:hover .project-image-wrap::after,
  .project-card--featured:focus-visible .project-image-wrap::after {
    opacity: 1;
  }

  .project-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    display: block;
  }

  .project-card--standard .project-image-wrap {
    --overlay-rest-height: 126px;
    aspect-ratio: 16 / 11;
    margin-bottom: 0;
  }

  .project-card--standard .project-image-wrap > img {
    /* Compose the screenshot for the exposed image strip. The overlay covers
       the lower part of the card, so there is no value in cropping artwork to
       fill space the visitor cannot see. */
    height: calc(100% - var(--overlay-rest-height));
    object-position: left center;
  }

  .project-overlay {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    height: var(--overlay-rest-height, 126px);
    padding: 20px 26px;
    overflow: hidden;
    /* Keep the detail surface fully opaque so the preview never competes
       with its copy as the panel rises. */
    background: var(--chip-bg);
    transition: height 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card--standard:hover .project-overlay,
  .project-card--standard:focus-visible .project-overlay {
    height: 62%;
  }

  .overlay-summary {
    flex-shrink: 0;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 10px;
  }

  .project-tag {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 3px 10px 4px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    font-size: 12px;
    font-weight: 550;
    line-height: 1;
  }

  .project-tag--primary {
    border-color: var(--text);
    background: var(--text);
    color: var(--bg);
  }

  .overlay-details {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    margin-top: 14px;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.22s ease,
      transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card--standard:hover .overlay-details,
  .project-card--standard:focus-visible .overlay-details {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.08s;
  }

  .project-title {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin-bottom: 3px;
  }

  .project-overlay .project-title {
    font-size: clamp(21px, 2vw, 27px);
    letter-spacing: -0.025em;
  }

  .project-role {
    color: var(--text);
    font-size: 13px;
    line-height: 1.45;
    margin-bottom: 7px;
  }

  .project-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .project-context {
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.5;
    margin-top: 8px;
  }

  .overlay-details .project-role {
    margin-bottom: 9px;
    font-weight: 650;
  }

  .overlay-details .project-desc {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .project-context--overlay {
    margin-top: auto;
    padding-top: 14px;
  }

  @media (min-width: 701px) and (max-width: 1000px) {
    .project-card--standard .project-image-wrap {
      --overlay-rest-height: 104px;
      aspect-ratio: 6 / 5;
    }

    .project-overlay {
      padding: 14px 18px;
    }

    .project-card--standard:hover .project-overlay,
    .project-card--standard:focus-visible .project-overlay {
      height: 58%;
    }

    .project-overlay .project-title {
      font-size: clamp(20px, 2.5vw, 24px);
    }

    .project-tags {
      gap: 6px;
      margin-top: 8px;
    }

    .project-tag {
      min-height: 24px;
      padding: 3px 9px;
      font-size: 11.5px;
    }

    .overlay-details {
      margin-top: 11px;
    }

    .overlay-details .project-role {
      margin-bottom: 6px;
      font-size: 12px;
    }

    .overlay-details .project-desc {
      font-size: 13px;
      line-height: 1.45;
      -webkit-line-clamp: 2;
    }

    .project-context--overlay {
      padding-top: 9px;
      font-size: 11.5px;
    }
  }

  @media (hover: none), (max-width: 700px) {
    .project-card:hover .project-image-wrap,
    .project-card:focus-visible .project-image-wrap {
      box-shadow: var(--chip-shadow);
      transform: none;
    }

    .project-card--standard .project-image-wrap {
      aspect-ratio: auto;
    }

    .project-card--standard .project-image-wrap img {
      height: auto;
      aspect-ratio: 16 / 10;
    }

    .project-overlay {
      position: static;
      height: auto;
      padding: 22px;
      overflow: visible;
    }

    .overlay-details {
      margin-top: 20px;
      opacity: 1;
      transform: none;
    }

    .overlay-details .project-desc {
      display: block;
      overflow: visible;
    }

    .project-context--overlay {
      margin-top: 18px;
      padding-top: 0;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .project-image-wrap,
    .project-card--featured .project-image-wrap::after,
    .project-card--standard .project-image-wrap > img,
    .project-overlay,
    .overlay-details {
      transition: none;
    }
  }
</style>
