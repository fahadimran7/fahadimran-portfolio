---
import { ArrowUpRight, Mail } from 'lucide-astro';
---

<section class="contact-cta" aria-labelledby="contact-heading">
  <p class="cta-eyebrow">Still here?</p>
  <h2 id="contact-heading">Let's build something worth shipping.</h2>
  <p>Convinced? Good. Click the button before I fall asleep again.</p>
  <a href="mailto:fahadimran6544@gmail.com" class="cta-button">
    <Mail size={17} /> Wake me up <ArrowUpRight size={16} />
  </a>
</section>

<style>
  .contact-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 72px 32px;
    border-radius: 24px;
    background: var(--text);
    color: var(--bg);
  }

  .cta-eyebrow {
    margin-bottom: 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .contact-cta h2 {
    max-width: 720px;
    font-size: clamp(34px, 4vw, 54px);
    line-height: 1.06;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .contact-cta > p:not(.cta-eyebrow) {
    max-width: 520px;
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.6;
    opacity: 0.74;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    padding: 12px 20px 13px;
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    font-size: 15px;
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .cta-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.24);
  }

  .cta-button:focus-visible {
    outline: 2px solid var(--bg);
    outline-offset: 4px;
  }

  @media (max-width: 570px) {
    .contact-cta {
      padding: 56px 22px;
      border-radius: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-button {
      transition: none;
    }
  }
</style>
