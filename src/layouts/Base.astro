---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Product engineer building payment products in small startup teams across web and mobile.',
  ogImage,
} = Astro.props;

const pageTitle = title === 'Home' ? 'Fahad Imran' : `${title} — Fahad Imran`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage ?? '/images/profile-photo.webp', Astro.site).href;
const twitterCard = ogImage ? 'summary_large_image' : 'summary';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f9f9f7" />

  <!-- Favicon -->
  <link rel="icon" type="image/webp" href="/favicon.webp" />

  <!-- Primary -->
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- OG -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:alt" content={pageTitle} />
  {ogImage && <meta property="og:image:width" content="1200" />}
  {ogImage && <meta property="og:image:height" content="630" />}

  <!-- Twitter -->
  <meta name="twitter:card" content={twitterCard} />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={pageTitle} />

  <ClientRouter />
</head>
<body>
  <header class="site-header" id="site-header" transition:persist>
    <nav>
      <a href="/" class="logo" aria-label="Fahad Imran — home">FI<span class="logo-dot" aria-hidden="true">.</span></a>
      <ul id="nav-links">
        <li><a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>about</a></li>
        <li><a href="/work" aria-current={Astro.url.pathname === '/work' ? 'page' : undefined}>work</a></li>
        <li><a href="/uses" aria-current={Astro.url.pathname === '/uses' ? 'page' : undefined}>uses</a></li>
        <li><a href="/ramblings" aria-current={Astro.url.pathname === '/ramblings' ? 'page' : undefined}>ramblings</a></li>
      </ul>
      <div class="nav-actions">
        <a class="btn-solid nav-cta" href="mailto:fahadimran6544@gmail.com">Connect</a>
        <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>
  </header>
  <div class="wrap">
    <main id="page-content">

      <slot />

    </main>

    <footer>
      <div class="footer-top">
        <a href="/" class="footer-brand">Fahad Imran</a>

        <div class="footer-col">
          <p class="footer-heading">Connect</p>
          <div class="footer-socials">
            <a href="https://github.com/fahadimran7" target="_blank" rel="noopener" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            </a>
            <a href="https://linkedin.com/in/fahadimran7" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="mailto:fahadimran6544@gmail.com" aria-label="Email">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </a>
          </div>
        </div>

        <div class="footer-col">
          <p class="footer-heading">Pages</p>
          <a href="/about">About</a>
          <a href="/work">Work</a>
          <a href="/uses">Uses</a>
          <a href="/ramblings">Ramblings</a>
        </div>

        <div class="footer-col footer-about">
          <p class="footer-heading">About</p>
          <p>Product engineer building payment products in small startup teams, from ambiguous problems to shipped features across web and mobile.</p>
        </div>
      </div>

      <div class="footer-bottom">
        &copy; {new Date().getFullYear()} Fahad Imran. All rights reserved.
      </div>
    </footer>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" inert>
    <nav class="mobile-nav">
      <a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>about</a>
      <a href="/work" aria-current={Astro.url.pathname === '/work' ? 'page' : undefined}>work</a>
      <a href="/uses" aria-current={Astro.url.pathname === '/uses' ? 'page' : undefined}>uses</a>
      <a href="/ramblings" aria-current={Astro.url.pathname.startsWith('/ramblings') ? 'page' : undefined}>ramblings</a>
      <a href="mailto:fahadimran6544@gmail.com">say hi</a>
    </nav>
  </div>

  <div class="site-cursor" id="site-cursor" aria-hidden="true" transition:persist>
    <span class="site-cursor__core">
      <span class="site-cursor__label"></span>
    </span>
  </div>

  <script>
    import Lenis from 'lenis';

    // Keep the physical page scroll native, then add a restrained inertia layer
    // for desktop wheel and trackpad input. Touch stays browser-native, which is
    // both more responsive and avoids interfering with the mobile carousels.
    let lenis;
    const smoothScrollQuery = window.matchMedia(
      '(min-width: 571px) and (prefers-reduced-motion: no-preference)',
    );

    function syncSmoothScroll() {
      if (smoothScrollQuery.matches && !lenis) {
        lenis = new Lenis({
          autoRaf: true,
          anchors: true,
          lerp: 0.15,
          wheelMultiplier: 0.9,
          syncTouch: false,
        });
      } else if (!smoothScrollQuery.matches && lenis) {
        lenis.destroy();
        lenis = undefined;
      }
    }

    syncSmoothScroll();
    smoothScrollQuery.addEventListener('change', syncSmoothScroll);

    // A deliberate desktop-only cursor treatment. The loop only runs while the
    // square is catching up to the pointer.
    const cursorQuery = window.matchMedia(
      '(min-width: 571px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
    );
    const cursor = document.getElementById('site-cursor');
    const cursorLabel = cursor?.querySelector('.site-cursor__label');
    let cursorFrame;
    let cursorHitTestFrame;
    let cursorLabelClearTimer;
    let cursorEnabled = false;
    let cursorHasPosition = false;
    let cursorTarget = { x: 0, y: 0 };
    let cursorCorePosition = { x: 0, y: 0 };

    function paintCursor(element, position) {
      element.style.transform = `translate3d(${position.x}px, ${position.y}px, 0)`;
    }

    function setCursorLabel(nextLabel) {
      if (!cursor || !cursorLabel) return;

      if (nextLabel) {
        if (cursorLabelClearTimer) clearTimeout(cursorLabelClearTimer);
        cursorLabelClearTimer = undefined;
        if (cursorLabel.textContent !== nextLabel) cursorLabel.textContent = nextLabel;
        cursor.style.setProperty('--cursor-label-width', `${Math.ceil(cursorLabel.scrollWidth) + 28}px`);
        cursor.classList.add('is-labelled');
        return;
      }

      if (!cursor.classList.contains('is-labelled')) return;
      cursor.classList.remove('is-labelled');
      cursorLabelClearTimer = window.setTimeout(() => {
        if (!cursor.classList.contains('is-labelled')) cursorLabel.textContent = '';
      }, 360);
    }

    function getCursorLabel(element) {
      const labelTarget = element?.closest('[data-cursor-label]');
      return labelTarget?.getAttribute('data-cursor-label')?.trim() || '';
    }

    function syncCursorLabelAtPointer() {
      cursorHitTestFrame = undefined;
      if (!cursorEnabled || !cursorHasPosition || !cursor?.classList.contains('is-visible')) return;
      const elementAtPointer = document.elementFromPoint(cursorTarget.x, cursorTarget.y);
      setCursorLabel(getCursorLabel(elementAtPointer));
    }

    function queueCursorHitTest() {
      if (!cursorHitTestFrame) cursorHitTestFrame = requestAnimationFrame(syncCursorLabelAtPointer);
    }

    function animateCursor() {
      cursorCorePosition.x += (cursorTarget.x - cursorCorePosition.x) * 0.56;
      cursorCorePosition.y += (cursorTarget.y - cursorCorePosition.y) * 0.56;
      if (cursor) paintCursor(cursor, cursorCorePosition);

      const remainingDistance = Math.hypot(
        cursorTarget.x - cursorCorePosition.x,
        cursorTarget.y - cursorCorePosition.y,
      );

      if (remainingDistance > 0.35) {
        cursorFrame = requestAnimationFrame(animateCursor);
      } else {
        cursorFrame = undefined;
      }
    }

    function moveCursor(event) {
      if (!cursorEnabled || event.pointerType !== 'mouse') return;
      cursorTarget = { x: event.clientX, y: event.clientY };
      setCursorLabel(getCursorLabel(event.target instanceof Element ? event.target : null));
      if (!cursorHasPosition) {
        cursorCorePosition = { ...cursorTarget };
        if (cursor) paintCursor(cursor, cursorCorePosition);
        cursorHasPosition = true;
      }
      cursor?.classList.add('is-visible');
      if (!cursorFrame) cursorFrame = requestAnimationFrame(animateCursor);
    }

    function hideCursor() {
      cursor?.classList.remove('is-visible');
      setCursorLabel('');
    }

    function syncCustomCursor() {
      cursorEnabled = cursorQuery.matches;
      document.documentElement.classList.remove('has-custom-cursor', 'custom-cursor-visible');
      if (!cursorEnabled) {
        hideCursor();
        cursorHasPosition = false;
        if (cursorFrame) cancelAnimationFrame(cursorFrame);
        if (cursorHitTestFrame) cancelAnimationFrame(cursorHitTestFrame);
        cursorFrame = undefined;
        cursorHitTestFrame = undefined;
      }
    }

    document.addEventListener('pointermove', moveCursor, { passive: true });
    document.addEventListener('scroll', queueCursorHitTest, { passive: true, capture: true });
    window.addEventListener('resize', queueCursorHitTest, { passive: true });
    document.documentElement.addEventListener('mouseleave', hideCursor);
    window.addEventListener('blur', hideCursor);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) hideCursor();
    });
    syncCustomCursor();
    cursorQuery.addEventListener('change', syncCustomCursor);

    // With the ClientRouter, pages swap in place and per-page <script> tags run
    // only once. So: bind window/document listeners a single time here, and
    // (re)bind the swapped-in header/menu on every astro:page-load.
    function updateNavGlass() {
      const header = document.getElementById('site-header');
      if (header) header.classList.toggle('scrolled', window.scrollY > 4);
    }

    // The header persists across client-side navigations (transition:persist),
    // so its server-rendered aria-current would freeze on the page we came from.
    // Recompute the active link from the new URL after every swap. Exact-match
    // per link, mirroring the desktop nav's server logic.
    function updateActiveNav() {
      const path = location.pathname;
      const links = document.querySelectorAll('#nav-links a');
      for (const a of links) {
        if (a.getAttribute('href') === path) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      }
    }

    function toggleMenu(open) {
      const menu = document.getElementById('mobile-menu');
      const hamburger = document.getElementById('hamburger');
      if (!menu || !hamburger) return;
      menu.classList.toggle('open', open);
      menu.inert = !open;
      hamburger.setAttribute('aria-expanded', open ? 'true' : 'false');
      // Lock the real scroll container (html), not body — locking body detaches
      // the sticky header and doesn't actually stop the page from scrolling.
      document.documentElement.style.overflow = open ? 'hidden' : '';
    }

    // Runs on every navigation. The header now persists across swaps, so its
    // controls keep their listeners — guard each binding with dataset.bound so
    // re-running this never stacks duplicate handlers on the same element.
    function initChrome() {
      updateNavGlass();
      updateActiveNav();
      syncCustomCursor();
      queueCursorHitTest();

      const hamburger = document.getElementById('hamburger');
      if (hamburger && !hamburger.dataset.bound) {
        hamburger.dataset.bound = '1';
        hamburger.addEventListener('click', function() {
          const menu = document.getElementById('mobile-menu');
          toggleMenu(!(menu && menu.classList.contains('open')));
        });
      }
    }

    // Bound once — these survive navigations.
    window.addEventListener('scroll', updateNavGlass, { passive: true });
    document.addEventListener('keydown', function(e) {
      const menu = document.getElementById('mobile-menu');
      if (e.key === 'Escape' && menu && menu.classList.contains('open')) toggleMenu(false);
    });
    // Never carry an open menu (or its scroll lock) across a navigation.
    document.addEventListener('astro:after-swap', function() {
      toggleMenu(false);
    });

    document.addEventListener('astro:page-load', initChrome);
  </script>
</body>
</html>
