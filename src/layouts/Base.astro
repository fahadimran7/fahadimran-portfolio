---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Product engineer building payment products in small startup teams across web and mobile.',
  ogImage,
} = Astro.props;

const pageTitle = title === 'Home' ? 'Fahad Imran' : `${title} — Fahad Imran`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage ?? '/images/profile-photo.webp', Astro.site).href;
const twitterCard = ogImage ? 'summary_large_image' : 'summary';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f9f9f7" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />

  <!-- Favicon -->
  <link rel="icon" type="image/webp" href="/favicon.webp" />

  <!-- Primary -->
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- OG -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:alt" content={pageTitle} />
  {ogImage && <meta property="og:image:width" content="1200" />}
  {ogImage && <meta property="og:image:height" content="630" />}

  <!-- Twitter -->
  <meta name="twitter:card" content={twitterCard} />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={pageTitle} />

  <!-- prevent flash of wrong theme -->
  <script is:inline>
    (function() {
      var stored = localStorage.getItem('theme');
      var prefer = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', stored || prefer);
    })();
  </script>

  <ClientRouter />
</head>
<body>
  <header class="site-header" id="site-header" transition:persist>
    <nav>
      <a href="/" class="logo" aria-label="Fahad Imran — home">FI<span class="logo-dot" aria-hidden="true">.</span></a>
      <ul id="nav-links">
        <li><a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>about</a></li>
        <li><a href="/work" aria-current={Astro.url.pathname === '/work' ? 'page' : undefined}>work</a></li>
        <li><a href="/uses" aria-current={Astro.url.pathname === '/uses' ? 'page' : undefined}>uses</a></li>
        <li><a href="/ramblings" aria-current={Astro.url.pathname === '/ramblings' ? 'page' : undefined}>ramblings</a></li>
      </ul>
      <div class="nav-actions">
        <a class="btn-solid nav-cta" href="mailto:fahadimran6544@gmail.com">Connect</a>
        <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>
  </header>
  <div class="wrap">
    <main id="page-content">

      <slot />

    </main>

    <footer>
      <div class="footer-top">
        <a href="/" class="footer-brand">Fahad Imran</a>

        <div class="footer-col">
          <p class="footer-heading">Connect</p>
          <div class="footer-socials">
            <a href="https://github.com/fahadimran7" target="_blank" rel="noopener" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            </a>
            <a href="https://linkedin.com/in/fahadimran7" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="mailto:fahadimran6544@gmail.com" aria-label="Email">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </a>
          </div>
        </div>

        <div class="footer-col">
          <p class="footer-heading">Pages</p>
          <a href="/about">About</a>
          <a href="/work">Work</a>
          <a href="/uses">Uses</a>
          <a href="/ramblings">Ramblings</a>
        </div>

        <div class="footer-col footer-about">
          <p class="footer-heading">About</p>
          <p>Product engineer building payment products in small startup teams, from ambiguous problems to shipped features across web and mobile.</p>
        </div>
      </div>

      <div class="footer-bottom">
        &copy; {new Date().getFullYear()} Fahad Imran. All rights reserved.
      </div>
    </footer>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" inert>
    <nav class="mobile-nav">
      <a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>about</a>
      <a href="/work" aria-current={Astro.url.pathname === '/work' ? 'page' : undefined}>work</a>
      <a href="/uses" aria-current={Astro.url.pathname === '/uses' ? 'page' : undefined}>uses</a>
      <a href="/ramblings" aria-current={Astro.url.pathname.startsWith('/ramblings') ? 'page' : undefined}>ramblings</a>
      <a href="mailto:fahadimran6544@gmail.com">say hi</a>
    </nav>
  </div>

  <script>
    // With the ClientRouter, pages swap in place and per-page <script> tags run
    // only once. So: bind window/document listeners a single time here, and
    // (re)bind the swapped-in header/menu on every astro:page-load.
    function updateNavGlass() {
      const header = document.getElementById('site-header');
      if (header) header.classList.toggle('scrolled', window.scrollY > 4);
    }

    // The header persists across client-side navigations (transition:persist),
    // so its server-rendered aria-current would freeze on the page we came from.
    // Recompute the active link from the new URL after every swap. Exact-match
    // per link, mirroring the desktop nav's server logic.
    function updateActiveNav() {
      const path = location.pathname;
      const links = document.querySelectorAll('#nav-links a');
      for (const a of links) {
        if (a.getAttribute('href') === path) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      }
    }

    function toggleMenu(open) {
      const menu = document.getElementById('mobile-menu');
      const hamburger = document.getElementById('hamburger');
      if (!menu || !hamburger) return;
      menu.classList.toggle('open', open);
      menu.inert = !open;
      hamburger.setAttribute('aria-expanded', open ? 'true' : 'false');
      // Lock the real scroll container (html), not body — locking body detaches
      // the sticky header and doesn't actually stop the page from scrolling.
      document.documentElement.style.overflow = open ? 'hidden' : '';
    }

    // Runs on every navigation. The header now persists across swaps, so its
    // controls keep their listeners — guard each binding with dataset.bound so
    // re-running this never stacks duplicate handlers on the same element.
    function initChrome() {
      updateNavGlass();
      updateActiveNav();

      const hamburger = document.getElementById('hamburger');
      if (hamburger && !hamburger.dataset.bound) {
        hamburger.dataset.bound = '1';
        hamburger.addEventListener('click', function() {
          const menu = document.getElementById('mobile-menu');
          toggleMenu(!(menu && menu.classList.contains('open')));
        });
      }
    }

    // Bound once — these survive navigations.
    window.addEventListener('scroll', updateNavGlass, { passive: true });
    document.addEventListener('keydown', function(e) {
      const menu = document.getElementById('mobile-menu');
      if (e.key === 'Escape' && menu && menu.classList.contains('open')) toggleMenu(false);
    });
    // Re-apply the theme before the swapped page paints, and never carry an open
    // menu (or its scroll lock) across a navigation.
    document.addEventListener('astro:after-swap', function() {
      const stored = localStorage.getItem('theme');
      const prefer = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', stored || prefer);
      toggleMenu(false);
    });

    document.addEventListener('astro:page-load', initChrome);
  </script>
</body>
</html>
